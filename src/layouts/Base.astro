---
// Every page: tokens, the element layer and the plain-HTML patterns layer, and the
// theme switch. StyleX output is appended to the same stylesheet at build time.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/patterns.css';
// Docs-only rules, scoped to .docs-prose. Loaded here so every page shares one
// stylesheet, the one StyleX appends its rules to.
import '../site/docs.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const { title, description, bodyClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Declare the element layer first, so StyleX's layers (declared later) always win,
         whatever order the stylesheets load in. -->
    <style is:inline>@layer normal-ui;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Apply a saved theme before first paint. No saved choice: follow the device.
      try {
        const t = localStorage.getItem('pd-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
    {import.meta.env.DEV && <script is:inline type="module" src="/@id/virtual:stylex:runtime"></script>}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
