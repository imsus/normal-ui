---
// A component's page: where it sits, a live example, its guidelines, what it is made
// of and used in, and React usage.
import Docs from '../layouts/Docs.astro';
import Demo from '../demos/Demo';
// Interactive demos hydrate through their group's island, so a page loads only the
// demos in its group rather than all of them.
import { Actions } from '../demos/actions';
import { Content } from '../demos/content';
import { Forms } from '../demos/forms';
import { Status } from '../demos/status';
import ActionsDemo from '../demos/islands/ActionsDemo';
import ContentDemo from '../demos/islands/ContentDemo';
import FormsDemo from '../demos/islands/FormsDemo';
import StatusDemo from '../demos/islands/StatusDemo';
import { LoadingDemo } from '../demos/loading';
import { components, levelOf, madeOf, summaryOf, usedIn } from '../lib/site';

interface Props { name: string }
const c = components.find((x) => x.name === Astro.props.name)!;
const level = levelOf(c.level);
const docs = import.meta.glob<{ Content: any }>('../../docs/components/*.md', { eager: true });
const Readme = docs[`../../docs/components/${c.name}.md`]?.Content;
const parts = madeOf(c);
const users = usedIn(c);
const n = c.name as never;
const island = !c.interactive ? null
  : c.name in Actions ? 'actions' : c.name in Content ? 'content' : c.name in Forms ? 'forms'
  : c.name in Status ? 'status' : c.name === 'Loading' ? 'loading' : null;
const imports = c.name === 'CommandDialog' ? 'Dialog' : c.name === 'ReviewComments' ? 'Suggestion, Commented, Comment' : c.name;
---
<Docs title={c.title} description={summaryOf(c.name)}>
  <p class="docs-meta">
    <a href={level.href} class="pd-badge">{level.singular}</a>
    <span>{c.group}</span>
    <code>{`<${imports.split(',')[0]}>`}</code>
  </p>
  <section aria-labelledby="demo-h" class="pd-stack" style="--pd-stack-gap: var(--space-sm); margin-block: var(--space-md) var(--space-lg)">
    <h2 id="demo-h" style="font-size:1rem">Live example</h2>
    <div style="border:1px solid var(--control-border); padding: var(--space-md); overflow:auto; background: var(--surface-soft)">
      {island === 'actions' ? <ActionsDemo name={n} client:visible />
        : island === 'content' ? <ContentDemo name={n} client:visible />
        : island === 'forms' ? <FormsDemo name={n} client:visible />
        : island === 'status' ? <StatusDemo name={n} client:visible />
        : island === 'loading' ? <LoadingDemo client:visible />
        : <Demo name={c.name} />}
    </div>
  </section>
  <div class="pd-content docs-prose">
    {Readme ? <Readme /> : <h1>{c.title}</h1>}
    {(parts.length > 0 || users.length > 0) && (
      <>
        <h2>Composition</h2>
        <dl>
          {parts.length > 0 && (
            <><dt>Made of</dt><dd>{parts.map((p, i) => <>{i > 0 && ', '}<a href={p.href}>{p.title}</a> <small>({levelOf(p.level).singular.toLowerCase()})</small></>)}</dd></>
          )}
          {users.length > 0 && (
            <><dt>Used in</dt><dd>{users.map((u, i) => <>{i > 0 && ', '}<a href={u.href}>{u.title}</a> <small>({levelOf(u.level).singular.toLowerCase()})</small></>)}</dd></>
          )}
        </dl>
      </>
    )}
    <h2>React</h2>
    <pre><code>{`import { ${imports} } from '../components';\n\n${c.usage}`}</code></pre>
  </div>
</Docs>
