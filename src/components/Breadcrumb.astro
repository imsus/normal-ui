---
import { linkClass } from "./link-class";

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  /** Crumbs left to right; the last receives aria-current="page" */
  items: Crumb[];
}

const { items } = Astro.props;

// Separator drawn by CSS between adjacent list items ("/") — markup stays
// crumb-only. The final crumb needs no extra styling here: index.css keys off
// a[aria-current] and applies the current-page treatment automatically.
const listClass =
  "flex list-none flex-wrap items-center p-0 font-mono text-xs [&_li+li]:before:content-['/'] [&_li+li]:before:mx-1.5 [&_li+li]:before:text-zinc-400 dark:[&_li+li]:before:text-zinc-500";
---

<nav aria-label="Breadcrumb">
  <ol class={listClass}>
    {
      items.map((crumb, i) => (
        <li>
          <a
            href={crumb.href}
            aria-current={i === items.length - 1 ? "page" : undefined}
            class={linkClass}
          >
            {crumb.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
