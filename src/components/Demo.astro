---
import { codeToHtml } from "shiki";

interface Props {
  /** State label shown in the preview corner */
  label: string;
  /** Specimen HTML — rendered live in the preview and listed highlighted below */
  markup: string;
  /** Whitespace-separated fragments of `markup` that differ from the Default specimen; tinted */
  changed?: string[];
}

const { label, markup, changed = [] } = Astro.props;

// The preview renders the specimen only. If a specimen ever embeds wiring (e.g. a
// script), it stays out of the live preview: set:html bakes it into the served HTML
// where the parser executes it, double-binding listeners next to the page module.
const wiringAt = markup.indexOf("<script");
const specimen = wiringAt === -1 ? markup : markup.slice(0, wiringAt);

// Text-node escaping only — shiki leaves quotes raw in token text, so must we.
const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

let highlighted = await codeToHtml(markup, { lang: "html", theme: "vesper" });

// Tint Δ-from-default fragments. Done on the finished HTML because shiki tokenizes
// `class="…"` opaquely and splits attributes across span boundaries — so an attribute
// fragment expands to its name and quoted value, and longest-first ordering keeps a
// bare name from shadowing longer utilities it prefixes. Lookarounds keep e.g. bare
// `disabled` from matching inside `disabled:opacity-50`.
//
// Replacement goes through \u0000-index sentinels so later, shorter targets can never
// re-match inside spans this pass already inserted.
const targets = [
  ...new Set(
    changed
      .flatMap((f) =>
        f.split(/\s+/).flatMap((p) => {
          const attr = p.match(/^([\w:-]+)="([^"]*)"$/);
          return attr ? [attr[1], `"${attr[2]}"`] : [p];
        }),
      )
      .filter((p) => p && !/^[=/><]+$/.test(p)),
  ),
].sort((a, b) => b.length - a.length);

const slots: string[] = [];
const tinted = targets.reduce(
  (acc, target) =>
    acc.replace(
      new RegExp(`(?<![\\w:@-])${escapeRe(escapeHtml(target))}(?![\\w:-])`, "g"),
      () => `\u0000${slots.push(escapeHtml(target)) - 1}\u0000`,
    ),
  highlighted,
);

highlighted = tinted.replace(/\u0000(\d+)\u0000/g, (_, i) =>
  `<span class="nui-delta">${slots[i]}</span>`,
);
---

<section class="overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-800">
  <div class="@container/preview relative block resize overflow-auto max-w-full">
    <div
      class="relative flex min-h-38 flex-wrap items-center justify-center gap-3 px-6 py-11 @max-sm/preview:px-3"
    >
      <span
        class="absolute top-3 left-4 font-mono text-xs tracking-widest text-zinc-500 uppercase"
        >{label}</span
      >
      <Fragment set:html={specimen} />
    </div>
  </div>
  <slot name="notes" />
  <div
    class="[&_pre]:m-0 [&_pre]:bg-transparent! overflow-x-auto border-t border-zinc-200 bg-zinc-950 px-5 py-4 font-mono text-xs leading-relaxed text-zinc-50 dark:border-zinc-800"
  >
    <Fragment set:html={highlighted} />
  </div>
</section>
