---
import Base from "../layouts/Base.astro";
import { linkClass } from "../components/link-class";
---

<Base title="Not found">
  <header class="flex flex-col gap-2">
    <p class="font-mono text-xs tracking-widest text-zinc-500 uppercase">404</p>
    <h1 class="text-2xl font-semibold tracking-tight">Page not found</h1>
    <p class="text-sm text-zinc-500">
      This URL doesn't match any component. Head back home and pick from the index.
    </p>
    <a href="/" class={`${linkClass} w-fit`}>Home</a>
  </header>
</Base>
