---
// Every text element the system styles, as rendered by base.css in the content
// rhythm. Plain HTML: what you see is what any page gets with no classes.
import Docs from '../layouts/Docs.astro';
import { examples, href } from '../lib/site';
const link = (name: string) => examples.find((e) => e.name === name)!.href;

const inline = [
  { tag: 'a', use: 'A link: names its destination, always underlined.', html: 'Read the <a href="#refunds">refund policy</a>.' },
  { tag: 'strong', use: 'Importance: the words a skimming reader must not miss.', html: '<strong>Orders after 14:00</strong> ship the next day.' },
  { tag: 'em', use: 'Stress that changes the meaning of the sentence.', html: 'Return it <em>before</em> you ask for a refund.' },
  { tag: 'b', use: 'Draws the eye without extra importance: a product name in a list.', html: 'The <b>Rattan tray</b> is back in stock.' },
  { tag: 'i', use: 'A different voice: foreign words, ship names, technical terms.', html: 'Woven in the <i>anyaman</i> style.' },
  { tag: 'u', use: 'Rare. Never for emphasis, since it looks like a link.', html: 'A <u>misspeled</u> word, marked by a spell checker.' },
  { tag: 's', use: 'No longer accurate, but kept for reference.', html: 'Was <s>Rp 350.000</s>, now Rp 289.000.' },
  { tag: 'mark', use: 'Highlight: one fact per section, or search matches. Black on yellow in both themes.', html: 'Returns are free <mark>until 31 October</mark>.' },
  { tag: 'small', use: 'Fine print, captions, notes. 0.83em, the smallest text allowed.', html: '<small>Prices include VAT.</small>' },
  { tag: 'code', use: 'A fragment of code, a file name, a value. 1em in the platform monospace.', html: 'Set <code>data-theme="dark"</code> on <code>&lt;html&gt;</code>.' },
  { tag: 'kbd', use: 'A key or keys the reader presses. Drawn as a keycap: 1px border on surface-muted.', html: 'Press <kbd>Ctrl</kbd> + <kbd>K</kbd> to search.' },
  { tag: 'samp', use: 'Output from a program. Browser default.', html: 'The page says <samp>Payment declined</samp>.' },
  { tag: 'var', use: 'A variable in maths or code. Browser default (italic).', html: 'Delivery takes <var>n</var> + 1 days.' },
  { tag: 'abbr', use: 'An abbreviation, expanded in its title. Dotted underline.', html: 'Shipping by <abbr title="Jalur Nugraha Ekakurir">JNE</abbr>.' },
  { tag: 'dfn', use: 'The defining instance of a term. Browser default (italic).', html: 'A <dfn>drop-off point</dfn> is a shop that accepts returns.' },
  { tag: 'cite', use: 'The title of a work. Browser default (italic).', html: 'As reviewed in <cite>Rumah Kita</cite> magazine.' },
  { tag: 'q', use: 'A short inline quotation. The browser adds the quote marks.', html: 'She called it <q>the best tray I own</q>.' },
  { tag: 'sub / sup', use: 'Subscripts and superscripts; superscript for footnote marks. They do not change the line height.', html: 'CO<sub>2</sub> neutral shipping<sup><a href="#fn1">1</a></sup> on 1<sup>st</sup> orders.' },
  { tag: 'del / ins', use: 'Removed and added text in a revision.', html: 'Delivery in <del>5</del> <ins>3</ins> days.' },
  { tag: 'time', use: 'A date or time, machine-readable in datetime. No visual change.', html: 'Posted on <time datetime="2026-09-30">30 September 2026</time>.' },
];
---
<Docs title="Typography" description="Every text element as the system renders it.">
  <div class="pd-content">
    <h1>Typography</h1>
    <p>
      Every text element as <code>base.css</code> renders it, in the content rhythm (the default; <code>.pd-content</code>
      inside an app). Nothing here uses a class: this is what plain HTML looks like in Normal UI. Sizes and
      line heights are in <a href={href('/tokens/')}>Tokens</a>; the app scale is in the
      <a href={link('HeadingRhythm')}>Heading rhythm</a> template, and a whole post in
      the <a href={link('BlogPost')}>Blog post</a> page.
    </p>

    <h2>Headings</h2>
    <p>One <code>h1</code> per page, then the levels in order. Never skip a level to get a smaller size.</p>
    <div style="border:1px solid var(--control-border);padding:var(--space-md) var(--space-lg)">
      <h1>Heading 1: the page title</h1>
      <h2>Heading 2: a section</h2>
      <h3>Heading 3: a subsection</h3>
      <h4>Heading 4: a minor heading</h4>
      <h5>Heading 5: a small heading</h5>
      <h6>Heading 6: the smallest heading</h6>
      <p>Body text after a heading. A heading sits half a line from the text it introduces and further from the text before it, so it groups with its own section.</p>
    </div>

    <h2>Paragraphs</h2>
    <p>
      Body text is 16px on a 24px line in the operating system's UI font. Paragraphs leave one line below them and
      none above. Keep lines under about 75 characters by limiting the width of the container (this page does it with
      <code>max-width</code>), and let the last line wrap evenly: paragraphs use <code>text-wrap: pretty</code>, so a
      single word is never left alone on a line.
    </p>
    <p><small>Small text is for fine print and captions only. It is 0.83em and nothing is smaller.</small></p>

    <h2>Inline text</h2>
    <div style="overflow-x:auto">
      <table style="width:100%">
        <caption>Text-level elements, each with its purpose and a live example</caption>
        <thead><tr><th scope="col">Element</th><th scope="col">Use it for</th><th scope="col">Example</th></tr></thead>
        <tbody>
          {inline.map((r) => (
            <tr>
              <th scope="row"><code>{r.tag}</code></th>
              <td>{r.use}</td>
              <td set:html={r.html} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p id="fn1"><small><sup>1</sup> Footnote target for the superscript example.</small></p>

    <h2>Lists</h2>
    <h3>Unordered</h3>
    <ul>
      <li>Hand-woven rattan trays</li>
      <li>Batik table runners
        <ul>
          <li>Pekalongan patterns</li>
          <li>Solo patterns</li>
        </ul>
      </li>
      <li>Teak cutting boards</li>
    </ul>
    <h3>Ordered</h3>
    <ol>
      <li>Open Your orders and choose the order.</li>
      <li>Select Return items and say why.
        <ol type="a">
          <li>Wrong size</li>
          <li>Arrived damaged</li>
        </ol>
      </li>
      <li>Show the QR code at a drop-off point.</li>
    </ol>
    <h3>Description list</h3>
    <dl>
      <dt>Standard delivery</dt>
      <dd>3 to 5 working days. Free over Rp 250.000.</dd>
      <dt>Express delivery</dt>
      <dd>1 to 2 working days in Java and Bali. Rp 35.000.</dd>
    </dl>

    <h2>Quotations</h2>
    <figure>
      <blockquote>
        <p>We stopped using bubble wrap last year. Every tray now ships in a box of recycled board and dried banana leaves, and not one has arrived broken.</p>
      </blockquote>
      <figcaption>Sari Wulandari, <cite>Packing notes</cite></figcaption>
    </figure>
    <p>Use <code>blockquote</code> for a quotation of a paragraph or more, inside a <code>figure</code> with a <code>figcaption</code> naming the source. Indented 40px, as the browser sets it.</p>

    <h2>Code blocks</h2>
    <pre><code>&lt;details name="faq"&gt;
  &lt;summary&gt;What does delivery cost?&lt;/summary&gt;
  &lt;p&gt;Free over Rp 250.000.&lt;/p&gt;
&lt;/details&gt;</code></pre>
    <p><code>pre</code> keeps whitespace, uses the platform monospace at 1em, and scrolls sideways inside its own box so the page never does.</p>

    <h2>Figures and images</h2>
    <figure>
      <svg viewBox="0 0 480 160" role="img" aria-labelledby="fig-t" style="width:100%;max-width:480px;display:block;border:1px solid var(--control-border)">
        <title id="fig-t">Orders per month, May to September: 210, 260, 245, 330, 412</title>
        <g fill="var(--link)">
          <rect x="40" y="88" width="56" height="52" /><rect x="120" y="75" width="56" height="65" />
          <rect x="200" y="79" width="56" height="61" /><rect x="280" y="57" width="56" height="83" />
          <rect x="360" y="37" width="56" height="103" />
        </g>
        <line x1="24" y1="140" x2="456" y2="140" stroke="var(--gray-text)" />
      </svg>
      <figcaption>Orders per month, May to September 2026. Images and SVG never grow wider than their container.</figcaption>
    </figure>

    <h2>Tables</h2>
    <div style="overflow-x:auto">
      <table>
        <caption>Orders by category, September</caption>
        <thead><tr><th scope="col">Category</th><th scope="col" style="text-align:end">Orders</th><th scope="col" style="text-align:end">Revenue</th></tr></thead>
        <tbody>
          <tr><th scope="row">Clothing</th><td style="text-align:end;font-variant-numeric:tabular-nums">623</td><td style="text-align:end;font-variant-numeric:tabular-nums">Rp 180.047.000</td></tr>
          <tr><th scope="row">Home and kitchen</th><td style="text-align:end;font-variant-numeric:tabular-nums">298</td><td style="text-align:end;font-variant-numeric:tabular-nums">Rp 43.570.000</td></tr>
          <tr><th scope="row">Food</th><td style="text-align:end;font-variant-numeric:tabular-nums">96</td><td style="text-align:end;font-variant-numeric:tabular-nums">Rp 9.216.000</td></tr>
        </tbody>
        <tfoot><tr><th scope="row">Total</th><td style="text-align:end;font-variant-numeric:tabular-nums">1,017</td><td style="text-align:end;font-variant-numeric:tabular-nums">Rp 232.833.000</td></tr></tfoot>
      </table>
    </div>

    <h2>Rules, addresses and disclosures</h2>
    <p>A thematic break between two parts of a section:</p>
    <hr />
    <p>The next part continues after the <code>hr</code>, which is a 1px <code>rule</code> line.</p>
    <address>
      Toko Rumah<br />
      Jl. Braga No. 12, Bandung 40111<br />
      <a href="mailto:help@example.com">help@example.com</a>
    </address>
    <p><code>address</code> is contact information for the page or article it sits in (browser default, italic).</p>
    <details>
      <summary>Can I change my address after ordering?</summary>
      <p>Yes, until the order is packed.</p>
    </details>
  </div>
</Docs>
