---
// One page of everything a theme touches: text, links, controls, a table, a message.
// The Themes page shows it in a frame per theme with ?theme=<id>; on its own it
// follows the theme chosen in the docs.
import Base from '../../layouts/Base.astro';
import { Alert, Badge, Button, Checkbox, Fieldset, Radio, Select, TextField } from '../../components';
---
<Base title="Theme specimen · Normal UI" bodyClass="pd-content">
  <header class="pd-masthead">
    <nav aria-label="Main" class="pd-cluster">
      <strong>Parts Office</strong>
      <a href="#basket">Basket</a>
      <a href="#delivery">Delivery</a>
      <a href="#returns">Returns</a>
    </nav>
  </header>
  <main class="pd-sheet" style="max-width:48rem">
    <p class="pd-eyebrow">Step 2 of 3</p>
    <h1>Order replacement parts</h1>
    <p>
      Parts ship the same day when ordered before 5pm. Read the <a href="#returns">returns policy</a> before
      sending anything back, or see <a href="#visited">parts you viewed</a>. Press <kbd>Ctrl</kbd>+<kbd>K</kbd> to
      search; part numbers look like <code>91251A540</code>. <mark>Stock is low</mark> on two items.
    </p>
    <h2 id="basket">Your basket</h2>
    <table>
      <caption>3 items</caption>
      <thead><tr><th scope="col">Part</th><th scope="col">Description</th><th scope="col" style="text-align:end">Qty</th><th scope="col" style="text-align:end">Price</th></tr></thead>
      <tbody>
        <tr><td><code>91251A540</code></td><td>Socket head screw, M5 × 12mm</td><td style="text-align:end">100</td><td style="text-align:end">£9.84</td></tr>
        <tr><td><code>94639A111</code></td><td>Nylon spacer, 6mm</td><td style="text-align:end">25</td><td style="text-align:end">£4.10</td></tr>
        <tr><td><code>6100K15</code></td><td>Steel ball bearing, 15mm</td><td style="text-align:end">4</td><td style="text-align:end">£23.60</td></tr>
      </tbody>
    </table>
    <h2 id="delivery">Delivery</h2>
    <div class="pd-stack">
      <Alert kind="error">Enter a company reference of 12 characters or fewer.</Alert>
      <Alert kind="warning">Two items ship from a different warehouse and arrive a day later.</Alert>
      <TextField label="Postcode" hint="For example, SW1A 2AA" autoComplete="postal-code" />
      <TextField label="Company reference" error="Enter a reference of 12 characters or fewer" aria-invalid="true" defaultValue="MAINTENANCE-DEPT-04" />
      <Select label="Delivery speed" defaultValue="next">
        <option value="std">Standard, 3 to 5 days</option>
        <option value="next">Next working day</option>
      </Select>
      <Fieldset legend="Packaging">
        <Radio name="pack" label="Bulk bag" defaultChecked />
        <Radio name="pack" label="Individually labelled" />
      </Fieldset>
      <Checkbox label="Email me when it ships" defaultChecked />
      <div class="pd-cluster">
        <Button type="submit" variant="primary">Place order</Button>
        <Button>Save for later</Button>
        <Button variant="warning">Empty basket</Button>
        <Button disabled>Request a quote</Button>
        <Badge>2 low stock</Badge>
      </div>
      <p>
        <button type="button" data-variant="primary">Plain primary</button>
        <button type="button">Plain HTML button</button>
        <input type="text" aria-label="Plain HTML field" placeholder="Plain HTML field" />
      </p>
    </div>
    <h2 id="returns">Returns</h2>
    <details>
      <summary>Can I return a part I have used?</summary>
      <p>Only if it was faulty. Unused parts in their original packaging can be returned within 30 days.</p>
    </details>
    <hr />
    <p><small>Prices include VAT. <a href="#top">Back to top</a></small></p>
  </main>
</Base>
