---
import Docs from '../../layouts/Docs.astro';
import { href } from '../../lib/site';
import { themes } from '../../themes';

/** Usage notes write token names in `backticks`: show them as code. */
const code = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Docs title="Themes" description="Styles on top of Normal UI: a set of token values and a few element rules, switched with data-style.">
  <h1>Themes</h1>
  <div class="pd-content docs-prose">
    <p>
      A theme is Normal UI with different values. It lists only what it changes and what it adds, in
      <code>themes/&lt;id&gt;/tokens.json</code>, plus a few element rules in <code>themes/&lt;id&gt;/theme.css</code>.
      Everything it does not mention stays Normal UI. Set it with <code>data-style</code>:
    </p>
<pre style="overflow-x:auto"><code>&lt;!-- Follows the device's light or dark --&gt;
&lt;html data-style="govuk"&gt;
&lt;!-- Forced dark --&gt;
&lt;html data-style="govuk" data-theme="dark"&gt;
&lt;!-- One part of a page --&gt;
&lt;section data-style="mcmaster"&gt;…&lt;/section&gt;</code></pre>
    <p>
      Use the Style switch at the top of any docs page to see every component, template and page in a theme;
      the previews follow it.
    </p>
    <h2>What a theme can change</h2>
    <ul>
      <li><strong>Every token</strong>, and the React components read them all, so they follow the theme:
        <ul>
          <li>colours in each mode, including button variants (<code>button-primary-*</code>, <code>button-warning-*</code>), hover and pressed fills, the button edge, status colours (<code>status-error</code>…), the focus inset, and the <code>page</code> and <code>masthead</code> fills;</li>
          <li>font stacks, and web fonts through <code>type.fonts</code>; the root size, with breakpoints (<code>type.rootSize</code>);</li>
          <li>spacing and radius;</li>
          <li>shape: border widths, <code>target-min</code>, button padding, edge, shadow and press offset, focus width and offset, checkbox and radio size, the sheet shadow;</li>
          <li>text: heading sizes for content and app UI, heading weight, control text, eyebrows, the <code>small</code> floor, error weight, and the link underline in navigation.</li>
        </ul></li>
      <li><strong>Its modes.</strong> <code>"modes": ["light"]</code> keeps a theme light whatever the device or <code>data-theme</code> says.</li>
      <li><strong>Element rules</strong> in <code>theme.css</code>, in the <code>normal-ui-theme</code> layer: after
        <code>normal-ui</code>, before StyleX. For what tokens cannot say: a dotted heading rule, catalog tables, drawn
        checkboxes. They restyle plain HTML but never beat a component's own styles.</li>
      <li><strong>Added tokens</strong> (marked <em>added</em> below) for things Normal UI has no role for, such as a bevel.
        In StyleX import them from <code>src/themes.stylex.ts</code>.</li>
    </ul>
    <p>
      Normal UI itself keeps its rules: every variant and status draws the same, links in navigation stay underlined,
      and the page, masthead and sheet look like the plain page. The tokens default to those values.
    </p>
    <h2>The contrast gate</h2>
    <p>
      <code>pnpm tokens</code> checks every theme, in both modes, against the same pairs as Normal UI (text 4.5:1,
      control edges, focus ring and accent 3:1), plus any pairs the theme adds. A failure stops the build. A theme
      may waive a pair only with a written reason, listed under the theme.
    </p>
  </div>

  {themes.map((t) => (
    <section aria-labelledby={`t-${t.id}`} style="margin-block-start:calc(var(--pd-line) * 2)">
      <h2 id={`t-${t.id}`}>{t.name} <small><code>data-style="{t.id}"</code>{t.modes.length === 1 && <> · {t.modes[0]} only</>}</small></h2>
      <p>{t.description} {t.inspiration && <>Inspired by <a href={t.inspiration}>{t.inspiration.replace(/^https?:\/\/(www\.)?|\/$/g, '')}</a>.</>}</p>
      <p><a href={href(`/themes/specimen/?style=${t.id}`)}>Open the {t.name} specimen on its own page</a></p>
      <div style="overflow:auto;border:1px solid var(--control-border);margin-block-end:var(--space-md)">
        <iframe src={href(`/themes/specimen/?style=${t.id}`)} title={`${t.name} specimen`} loading="lazy"
          style="display:block;border:0;width:100%;min-width:20rem;height:56rem"></iframe>
      </div>
      <h3>Deliberate departures</h3>
      <ul>
        {t.notes.map((n) => <li set:html={code(n)} />)}
        {t.waived.map((w) => <li><code>{w.fg}</code> on <code>{w.bg}</code> ({w.mode}) is {w.ratio}:1, under {w.min}:1. <Fragment set:html={code(w.waived)} /></li>)}
      </ul>
      <h3>Tokens</h3>
      <div style="overflow-x:auto">
        <table style="width:100%">
          <thead><tr><th scope="col">Token</th><th scope="col">Light</th><th scope="col">Dark</th><th scope="col">Usage</th></tr></thead>
          <tbody>
            {t.colors.map((c) => (
              <tr>
                <th scope="row"><code>--{c.name}</code>{c.added && <> <span class="pd-badge">added</span></>}</th>
                {['light', 'dark'].map((m) => !c.values[m] ? <td>(no {m} mode)</td> : (
                  <td style="white-space:nowrap">
                    <span aria-hidden="true" style={`display:inline-block;width:1.25em;height:1.25em;vertical-align:middle;margin-inline-end:var(--space-xs);border:1px solid var(--control-border);background:${c.values[m]}`}></span>
                    <code>{c.values[m]}</code>
                  </td>
                ))}
                <td set:html={code(c.usage)} />
              </tr>
            ))}
            {Object.entries(t.families).map(([k, v]) => (
              <tr><th scope="row"><code>--font-{k}</code></th><td colspan="2"><code>{v}</code></td><td></td></tr>
            ))}
            {t.rootSize && <tr><th scope="row"><code>--font-size-root</code></th><td colspan="2"><code>{t.rootSize}</code></td><td>Root text size; every rem follows it.</td></tr>}
            {t.lengths.map((l) => (
              <tr><th scope="row"><code>--{l.name}</code>{l.added && <> <span class="pd-badge">added</span></>}</th><td colspan="2"><code>{l.value}</code></td><td set:html={code(l.usage)} /></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Docs>
