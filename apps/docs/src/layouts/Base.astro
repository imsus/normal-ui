---
// Every page: tokens, the element layer and the plain-HTML patterns layer, and the
// color-scheme and theme switch. StyleX output is appended to the same stylesheet at build time.
import '@imsus/normal-ui-css';
// Every theme's values, scoped to [data-theme="<id>"], and its element rules.
import '@imsus/normal-ui-css/themes.css';
// Docs-only rules, scoped to .docs-prose. Loaded here so every page shares one
// stylesheet, the one StyleX appends its rules to.
import '../site/docs.css';
import { themes } from '@imsus/normal-ui-css/themes';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const { title, description, bodyClass } = Astro.props;
const themeIds = themes.map((t) => t.id);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Declare the element layer and the theme layer first, so StyleX's layers (declared
         later) always win, whatever order the stylesheets load in. -->
    <style is:inline>@layer normal-ui, normal-ui-theme;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline define:vars={{ themeIds }}>
      // Apply the saved Color scheme and Theme before first paint. No saved choice:
      // follow the device, in plain Normal UI. ?theme=<id> in the URL wins over the saved
      // theme for this page only (the docs' theme previews use it).
      (function () {
        var root = document.documentElement;
        var forced = new URLSearchParams(location.search).get('theme');
        function apply() {
          var t = null, st = null;
          try { t = localStorage.getItem('pd-color-scheme'); st = localStorage.getItem('pd-theme'); } catch (e) {}
          if (t === 'light' || t === 'dark') root.dataset.colorScheme = t; else delete root.dataset.colorScheme;
          st = forced !== null ? forced : st;
          if (themeIds.indexOf(st) !== -1) root.dataset.theme = st; else delete root.dataset.theme;
        }
        apply();
        // A change in another tab, or in the docs page around a preview frame, follows here.
        addEventListener('storage', function (e) { if (e.key === 'pd-color-scheme' || e.key === 'pd-theme') apply(); });
      })();
    </script>
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
    {import.meta.env.DEV && <script is:inline type="module" src="/@id/virtual:stylex:runtime"></script>}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
